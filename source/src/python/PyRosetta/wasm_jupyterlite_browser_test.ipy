# Browser end of `build-wasm.py --jupyterlite-browser-test`. The harness opens
# the site's REPL with this file as its one cell, so the site's own kernel
# worker runs it in a real browser. It installs PyRosetta as the example
# notebook does, and imports and initialises it. Then it moves a PDB through the
# file browser's /drive and runs the notebook's cell that fetches one from RCSB.
# It posts each stage and a verdict back to the harness. The harness puts the
# run's token in place of @RUN_TOKEN@.
import json
import os
import traceback

import pyodide_js
import pyodide_kernel
from pyodide.http import pyfetch

RUN_TOKEN = "@RUN_TOKEN@"
marks = []
streamed = []


# The verdict is judged on the text the kernel hands the worker as this cell's
# output, as the notebook test's is. The worker binds these callbacks afresh
# for every execute request, so wrapping them here lasts for this cell alone.
def record(forward):
    def publish(name, text):
        streamed.append(str(text))
        forward(name, text)

    return publish


for stream in (pyodide_kernel.stdout_stream, pyodide_kernel.stderr_stream):
    stream.publish_stream_callback = record(stream.publish_stream_callback)


async def post(path, **body):
    await pyfetch(
        path,
        method="POST",
        headers={"Content-Type": "application/json"},
        body=json.dumps({"token": RUN_TOKEN, **body}),
    )


async def mark(name, **detail):
    # wasm32 addresses at most 4 GB of linear memory, whatever the machine has.
    detail["wasmHeap"] = pyodide_js._module.HEAPU8.length
    marks.append({"name": name, **detail})
    await post("/mark", name=name, detail=detail)


error = None
try:
    # The working directory says whether the worker mounted the file browser
    # at /drive, which the harness requires. It does so only where the page can
    # sync with the file browser, through a service worker or cross-origin
    # isolation.
    await mark("kernel-ready", cwd=os.getcwd())
    %pip install pyrosetta
    await mark("wheel-installed")
    import pyrosetta
    await mark("pyrosetta-imported")
    pyrosetta.init()
    await mark("pyrosetta-initialised")

    # A file the kernel writes to /drive is saved into the file browser's
    # storage by the same call an upload of up to 1 MB makes, and a download
    # reads it back from there. So a PDB written and loaded again has gone both
    # ways. The copy in /tmp never leaves Pyodide's in-memory filesystem.
    peptide = pyrosetta.pose_from_sequence("AFILVWYGPSTNQ")
    peptide.dump_pdb("round-trip.pdb")
    peptide.dump_pdb("/tmp/round-trip.pdb")
    reloaded = pyrosetta.pose_from_pdb("round-trip.pdb")
    with open("round-trip.pdb", "rb") as drive, open("/tmp/round-trip.pdb", "rb") as memory:
        identical = drive.read() == memory.read()
    await mark(
        "pdb-round-trip",
        cwd=os.getcwd(),
        listed="round-trip.pdb" in os.listdir(),
        identical=identical,
        residues=reloaded.total_residue(),
        expected=peptide.total_residue(),
    )

    # The example notebook's browser-only cell, verbatim.
    import pyodide_http
    pyodide_http.patch_all()

    from pyrosetta.toolbox.rcsb import pose_from_rcsb

    ubiquitin = pose_from_rcsb("1UBQ")
    print(f"1UBQ: {ubiquitin.total_residue()} residues")
    await mark(
        "rcsb-fetched",
        cwd=os.getcwd(),
        listed="1UBQ.clean.pdb" in os.listdir(),
        residues=ubiquitin.total_residue(),
    )
except BaseException:
    error = traceback.format_exc()
    print(error)
await post("/result", ok=error is None, error=error, marks=marks, output="".join(streamed))

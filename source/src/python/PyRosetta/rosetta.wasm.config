# Binder config additions layered on top of rosetta.config when
# build.py runs with --target wasm. Each `-class` / `-function` here
# is paired with a matching TU exclusion in rosetta.wasm.exclude so
# the generated bindings do not reference removed symbols.
#
# Loaded by build.py when Options.target == 'wasm'. See task 0014.

# core/scoring/constraints/SequenceProfileConstraint.cc fails to compile
# under emscripten libc++ at the boost::lexical_cast<Size> call site
# (line 157): the boost::numeric MPL chain instantiates
# `integral_c<udt_builtin_mixture_enum, -1>::prior` which trips C++17
# strict-constexpr enum-range checks.
-class core::scoring::constraints::SequenceProfileConstraint
-class core::scoring::constraints::SequenceProfileConstraintCreator

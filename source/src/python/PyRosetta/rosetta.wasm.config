# Binder config additions layered on top of rosetta.config when
# build.py runs with --target wasm. Each directive here drops a binding
# that Binder emits for the native toolchain but that does not compile
# against emscripten's libc++ / header set.
#
# Loaded by build.py when Options.target == 'wasm'. See task 0014.

# std::chrono::duration<double,...>: the generated binding wires operator%=
# (__imod__), which is ill-formed for a floating-point rep under libc++
# (__chrono/duration.h). rosetta.config already excludes this, but with the
# libstdc++ spelling (std::ratio<1, 1>); libc++ spells it std::ratio<1>, so
# that directive does not match here. Drop the whole namespace — PyRosetta
# does not expose std::chrono to Python.
-namespace std::chrono

# std::vector<RDKit::Dict::Pair>: the generated binding references RDKit::Dict::Pair
# but, being in namespace std, does not trigger rosetta.config's
# `+include_for_namespace RDKit ...` rule, so the RDKit header is not pulled into
# the TU and RDKit is undeclared. rosetta.config already excludes other RDKit
# std-containers (e.g. std::vector<RDKit::StereoGroup>); add this one for WASM.
-class std::vector<RDKit::Dict::Pair>
